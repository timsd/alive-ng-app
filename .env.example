# ==============================================================================
# ALIVE Nigeria App - Environment Variables Template
# Copy this file to .env and replace placeholders with actual credentials.
# NEVER commit your actual .env file with real secrets to version control.
# ==============================================================================

# Appwrite Cloud / Self-hosted Configuration
APPWRITE_ENDPOINT=https://api.alivenigeria.org/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id
APPWRITE_DATABASE_ID=your_appwrite_database_id
APPWRITE_API_KEY=your_appwrite_admin_api_key_here
APPWRITE_FCM_PROVIDER_ID=your_fcm_provider_id
APPWRITE_RESOURCES_BASE_URL=https://app.alivenigeria.org/resources
APPWRITE_SUPER_ADMIN_EMAILS=alivenigeria2011@gmail.com,app@alivenigeria.org

# Paystack Payment Gateway
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_WEBHOOK_URL=https://api.alivenigeria.org/webhooks/paystack
PAYSTACK_CALLBACK_URL=https://app.alivenigeria.org/payment/callback

# LiveKit Video / Meeting Infrastructure
LIVEKIT_URL=wss://livekit.alivenigeria.org
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# GlitchTip / Sentry Crash Reporting
GLITCHTIP_DSN=https://your_key@glitchtip.alivenigeria.org/1
GLITCHTIP_ENVIRONMENT=production
GLITCHTIP_RELEASE=alive-ng-app@2.0.4+11
GLITCHTIP_TRACES_SAMPLE_RATE=0

# Firebase Web / Mobile Configuration
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
FIREBASE_WEB_APP_ID=1:000000000000:web:0000000000000000000000
FIREBASE_WEB_PROJECT_ID=alive-ng-flutter-app
FIREBASE_WEB_AUTH_DOMAIN=alive-ng-flutter-app.firebaseapp.com
FIREBASE_WEB_STORAGE_BUCKET=alive-ng-flutter-app.firebasestorage.app
FIREBASE_WEB_MESSAGING_SENDER_ID=000000000000
FIREBASE_WEB_MEASUREMENT_ID=G-XXXXXXXXXX

# Google OAuth Client IDs
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com

# Web Push Notification Keys
WEB_PUSH_CERT_KEY=your_vapid_public_key
WEB_PUSH_PRIVATE_KEY=your_vapid_private_key
WEB_PUSH_SUBJECT=mailto:app@alivenigeria.org

# reCAPTCHA Enterprise
RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Resend Email Delivery
RESEND_API_KEY=re_your_resend_api_key

# Coolify CI / CD Deployment
COOLIFY_API_URL=https://coolify.yourdomain.com
COOLIFY_API_TOKEN=your_coolify_api_token
COOLIFY_SERVICE_UUID=your_service_uuid

