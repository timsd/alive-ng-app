/android/local.properties
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
 
# Logs and text notes
*.log
logs/
*.txt
 
# Markdown docs (keep README.md)
*.md
!README.md
!PROJECT_TOOLS_AND_PLATFORMS.md
!docs/**/*.md
docs/oracle-free-tier-deployment-roadmap.md
!/functions/**/README.md
 
# Local Chrome downloaded by tooling
/.local-chrome/
/.gradle-build/
/.gradle-build*/
/android/gradle/*.zip

# Local IDE/workspace metadata
.trae/
.vscode/
.claude/

/android/key.properties.*
android/.kotlin/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Development scratch scripts
/scratch/
cleanup.py
create_nlt_bundle.py

# Agent configurations
.agents/

# Database backups created by maintenance scripts. These are copies of
# assets/bible/bible.db and must never be committed or bundled: the
# pubspec assets list used to include the whole assets/bible/ directory, so
# each backup silently added ~60-70 MB to the web build for every visitor.
assets/bible/*.bak
assets/bible/*.bak-*
*.db.bak

.tmp-backups/
.tmp_*

