rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Development mode bypass - allows admin access in development
    function isDevelopmentBypass() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/app_settings/development_config) &&
             get(/databases/$(database)/documents/app_settings/development_config).data.bypassRoleGuards == true;
    }
    
    // Enhanced admin check with development bypass
    function isAdminOrDevelopmentBypass() {
      return isAdmin() || isDevelopmentBypass();
    }
    
    // User profiles - users can read/write their own profile
    match /profiles/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
      allow read: if isAdmin();
    }
    
    // Prayer requests - authenticated users can read all, write their own
    match /prayer_requests/{requestId} {
      allow read: if isAuthenticated();
      allow update, delete: if isAuthenticated() && isOwner(resource.data.user_id);
      allow create: if isAuthenticated() && isOwner(request.resource.data.user_id);
    }
    
    // Prayer supporters - users can manage their own prayer support records
    match /prayer_supporters/{supportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(request.resource.data.user_id);
      allow delete: if isAuthenticated() && isOwner(resource.data.user_id);
    }
    
    // Prayer interactions - users can create interactions for themselves
    match /prayer_interactions/{interactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(request.resource.data.user_id);
    }
    
    // Health activities - users can manage their own activities
    match /health_activities/{activityId} {
      allow read, write: if isAuthenticated() && isOwner(resource.data.user_id);
      allow create: if isAuthenticated() && isOwner(request.resource.data.user_id);
    }
    
    // Health tracking - align with app usage (user-specific docs)
    match /health_tracking/{doc} {
      allow read: if isAuthenticated() && isOwner(resource.data.user_id);
      allow create: if isAuthenticated() && isOwner(request.resource.data.user_id);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.user_id);
    }
    
    // Missions - read-only for authenticated users, admin can write
    match /missions/{missionId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrDevelopmentBypass();
    }
    
    // Mission participants - user-specific participation records
    match /mission_participants/{doc} {
      allow read: if isAuthenticated() && isOwner(resource.data.user_id);
      allow create: if isAuthenticated() && isOwner(request.resource.data.user_id);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.user_id);
    }
    
    // Kids content - read-only for authenticated users, admin can write
    match /kids_content/{contentId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrDevelopmentBypass();
    }
    
    // Memory verses - read-only for authenticated users, admin can write
    match /memory_verses/{verseId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrDevelopmentBypass();
    }
    
    // Prayer activities - read-only for authenticated users, admin can write
    match /prayer_activities/{activityId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrDevelopmentBypass();
    }

    // Chat Channels & Messages
    match /chat_channels/{channelId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.members || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.members || isAdmin());
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/chat_channels/$(channelId)).data.members || isAdmin());
        allow create: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/chat_channels/$(channelId)).data.members || isAdmin());
      }

      // Member status (last_seen, etc.)
      match /members/{memberId} {
        allow read: if isAuthenticated() && (request.auth.uid == memberId || request.auth.uid in get(/databases/$(database)/documents/chat_channels/$(channelId)).data.members || isAdmin());
        allow write: if isAuthenticated() && (request.auth.uid == memberId || isAdmin());
      }
    }

    // Chapters
    match /chapters/{chapterId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrDevelopmentBypass();
    }

    // Chapter Memberships
    match /chapter_members/{membershipId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.user_id) || isAdmin());
      allow create: if isAuthenticated() && isOwner(request.resource.data.user_id);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.user_id);
    }
    
    // Service projects - read-only for authenticated users, admin can write
    match /service_projects/{projectId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrDevelopmentBypass();
    }
    
    // Kids stories - read-only for authenticated users, admin can write
    match /kids_stories/{storyId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrDevelopmentBypass();
    }
    
    // Podcasts - read-only for authenticated users, admin can write
    match /podcasts/{podcastId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Tract categories - authenticated read, admin write
    match /tract_categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrDevelopmentBypass();
    }

    // Podcast categories - authenticated read, admin write
    match /podcast_categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Events - read-only for authenticated users, admin can write
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Announcements - read-only for authenticated users, admin can write
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // User missions - users can manage their own mission enrollments
    match /user_missions/{userMissionId} {
      allow read, write: if isAuthenticated() && isOwner(resource.data.user_id);
      allow create: if isAuthenticated() && isOwner(request.resource.data.user_id);
    }
    
    // Study programs - read-only for authenticated users, admin can write
    match /study_programs/{programId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // User study programs - users can manage their own enrollments
    match /user_study_programs/{userProgramId} {
      allow read, write: if isAuthenticated() && isOwner(resource.data.user_id);
      allow create: if isAuthenticated() && isOwner(request.resource.data.user_id);
    }
    
    // Daily verses - read-only for authenticated users, admin can write
    match /daily_verses/{verseId} {
      // Allow guests to read daily verse content
      allow read: if true;
      allow write: if isAdminOrDevelopmentBypass();
    }
    
    // User statistics - users can read/write their own stats
    match /user_statistics/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
      allow read: if isAdmin();
    }
    
    // User events - users can create their own events
    match /user_events/{eventId} {
      allow read, write: if isAuthenticated() && isOwner(resource.data.user_id);
      allow create: if isAuthenticated() && isOwner(request.resource.data.user_id);
    }
    
    // Push tokens - users can manage their own tokens
    match /push_tokens/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }
    
    // Notification settings - users can manage their own settings
    match /notification_settings/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }
    
    // Content pages - read-only for authenticated users, admin can write
    match /content_pages/{pageId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Dynamic content - read-only for authenticated users, admin can write
    match /dynamic_content/{contentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Study guides - read-only for authenticated users, admin can write
    match /study_guides/{guideId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Study guide lessons - read-only for authenticated users, admin can write
    match /study_guide_lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Study questions - read-only for authenticated users, admin can write
    match /study_questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // User study progress - users can manage their own progress
    match /user_study_progress/{progressId} {
      allow read, write: if isAuthenticated() && isOwner(resource.data.user_id);
      allow create: if isAuthenticated() && isOwner(request.resource.data.user_id);
    }
    
    // Alias collection used by app services: study_guide_progress
    match /study_guide_progress/{progressId} {
      allow read, write: if isAuthenticated() && isOwner(resource.data.user_id);
      allow create: if isAuthenticated() && isOwner(request.resource.data.user_id);
    }
    
    // User lesson progress - users can manage their own progress
    match /user_lesson_progress/{progressId} {
      allow read, write: if isAuthenticated() && isOwner(resource.data.user_id);
      allow create: if isAuthenticated() && isOwner(request.resource.data.user_id);
    }
    
    // Study sessions - facilitator manages, participants can read
    match /study_sessions/{sessionId} {
      // Read if facilitator, participant, or admin
      allow read: if isAuthenticated() && (
        isOwner(resource.data.facilitator_id) ||
        isAdmin() ||
        (resource.data.keys().hasAny(['participant_ids']) && request.auth.uid in resource.data.participant_ids)
      );
      // Write allowed to facilitator or admin
      allow write: if isAuthenticated() && (
        isOwner(resource.data.facilitator_id) || isAdmin()
      );
      // Create by facilitator
      allow create: if isAuthenticated() && isOwner(request.resource.data.facilitator_id);
    }
    
    // User roles - admin only
    match /user_roles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrDevelopmentBypass();
    }
    
    // Storage files - admin only
    match /storage_files/{fileId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrDevelopmentBypass();
    }
    
    // Admin notifications - admin only
    match /admin_notifications/{notificationId} {
      allow read, write: if isAdminOrDevelopmentBypass();
    }
    
    // Downloadable materials - read for authenticated users
    // Admins can create/delete; authenticated users may update download_count and updated_at
    match /downloadable_materials/{materialId} {
      allow read: if isAuthenticated();
      
      // Admin full control for creating/deleting materials and metadata edits
      allow create, delete: if isAdmin();
      
      // Updates:
      // - Admin: any field
      // - Authenticated users: only increment download_count and set updated_at
      allow update: if isAdmin() || (
        isAuthenticated() &&
        // Only these fields may change in a user-driven update
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['download_count', 'updated_at']) &&
        // Require download_count to increase by exactly 1
        request.resource.data.download_count == resource.data.download_count + 1
      );
    }
    
    // Daily verse tracking table used by generator
    match /daily_verse_tracking/{docId} {
      // Keep reads aligned with app flows (authenticated)
      allow read: if isAuthenticated();
      // Writes restricted to specific fields when client marks usage
      allow create, update: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['verse_reference', 'translation', 'book', 'chapter', 'verse_number', 'is_used', 'used_date']);
    }
    
    // Chapters - read-only for authenticated users, admin can write
    match /chapters/{chapterId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Tracts - read-only for authenticated users, admin can write
    match /tracts/{tractId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Tract contents - read-only for authenticated users, admin can write
    match /tract_contents/{contentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Podcast episodes - read-only for authenticated users, admin can write
    match /podcast_episodes/{episodeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Leadership records - authenticated read, owner can update own status, admin full write
    match /leadership_records/{recordId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId) && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time;
      allow update: if isAuthenticated() && isOwner(resource.data.userId) && resource.data.status == 'pending' && onlyUpdating(['title', 'description', 'chapterId', 'updatedAt']) && request.resource.data.updatedAt == request.time;
      allow delete: if isAuthenticated() && isOwner(resource.data.userId) && resource.data.status == 'pending';
      allow write: if isAdmin();

      // Chapter leaders can approve or reject records for their chapters
      allow update: if isAuthenticated() && isChapterLeader(resource.data.chapterId) && resource.data.status == 'pending' && request.resource.data.status in ['approved', 'rejected'] && onlyUpdating(['status', 'approvedBy', 'approvedAt', 'rejectionReason']);
    }

    // Helper function for chapter leadership validation 
    function isChapterLeader(chapterId) { 
      return exists(/databases/$(database)/documents/chapters/$(chapterId)/leaders/$(request.auth.uid));
    }

    // Helper function to validate limited field updates
    function onlyUpdating(allowedFields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }
    
    // Chapter members - users manage own membership, admin can write
    match /chapter_members/{memberId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(request.resource.data.user_id);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.user_id);
      allow write: if isAdmin();
    }
    
    // Chapter memberships - users manage own memberships, admin can write
    match /chapter_memberships/{membershipId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(request.resource.data.user_id);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.user_id);
      allow write: if isAdmin();
    }
    
    // Donation records - users can read/write their own donations, admin can read all
    match /donation_records/{donationId} {
      allow read: if isAuthenticated() && isOwner(resource.data.user_id);
      // Guest read access for guest-created donation docs only
      allow read: if !isAuthenticated() &&
        resource.data.user_id is string &&
        resource.data.user_id.matches('^guest-[A-Za-z0-9-]{8,}$');
      // Authenticated user donation
      allow create: if isAuthenticated() && isOwner(request.resource.data.user_id);
      // Guest donation (strictly constrained)
      allow create: if !isAuthenticated() &&
        request.resource.data.user_id is string &&
        request.resource.data.user_id.matches('^guest-[A-Za-z0-9-]{8,}$') &&
        request.resource.data.user_email is string &&
        request.resource.data.user_email.size() > 5 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.payment_method == 'paystack' &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.keys().hasOnly([
          'id',
          'user_id',
          'user_name',
          'user_email',
          'type',
          'amount',
          'currency',
          'status',
          'payment_method',
          'payment_intent_id',
          'transaction_id',
          'metadata',
          'material_id',
          'material_title',
          'notes',
          'created_at',
          'updated_at',
          'completed_at'
        ]);
      allow update: if isAuthenticated() && isOwner(resource.data.user_id);
      // Guest update access: permit payment-status updates only; core identity/amount fields immutable
      allow update: if !isAuthenticated() &&
        resource.data.user_id is string &&
        resource.data.user_id.matches('^guest-[A-Za-z0-9-]{8,}$') &&
        request.resource.data.user_id == resource.data.user_id &&
        request.resource.data.user_email == resource.data.user_email &&
        request.resource.data.amount == resource.data.amount &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.currency == resource.data.currency &&
        request.resource.data.created_at == resource.data.created_at &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'updated_at',
          'payment_intent_id',
          'transaction_id',
          'metadata',
          'completed_at'
        ]);
      allow read, write: if isAdmin();
    }

    // Approval tokens for email-link approvals
    // Read/update are handled server-side via Cloud Functions.
    // Client can only create token docs if admin.
    match /approval_tokens/{tokenId} {
      allow create: if isAdmin();
      allow read, update, delete: if false;
    }
    
    // App settings - read for authenticated users, write for admin
    match /app_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Meeting files - read for authenticated users, write for admin
    match /meeting_files/{fileId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Notification history - users can read their own history
    match /notification_history/{notificationId} {
      allow read: if isAuthenticated() && isOwner(resource.data.user_id);
      allow create: if isAuthenticated() && isOwner(request.resource.data.user_id);
      allow read, write: if isAdmin();
    }
    
    // User downloads - users can read their own downloads, admin can read all
    match /user_downloads/{downloadId} {
      allow read: if isAuthenticated() && isOwner(resource.data.user_id);
      allow create: if isAuthenticated() && isOwner(request.resource.data.user_id);
      allow read, write: if isAdmin();
    }
    
    // Payment logs - users can read their own payment logs, admin can read all
    // Only Firebase Functions can create/update payment logs
    match /payment_logs/{logId} {
      allow read: if isAuthenticated() && isOwner(resource.data.user_id);
      allow read: if isAdminOrDevelopmentBypass();
      // Only allow creation/updates from server-side (Firebase Functions)
      // This is enforced by not allowing client-side writes
    }
    
    // Development configuration - admin only access
    match /app_settings/development_config {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // User profiles - users manage their own profile; admin full access
    match /profiles/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAuthenticated() && request.auth.uid == uid;
      allow write: if isAdmin();
    }
    
    // Alias collection used by app services: user_profiles
    match /user_profiles/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAuthenticated() && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // Learning resources - read for authenticated users, write for admin or dev bypass
    match /learning_resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrDevelopmentBypass();
    }

    // Downloadable materials - read for authenticated users, write for admin
    match /downloadable_materials/{materialId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Cleanup logs - admin-only for storage maintenance
    match /cleanup_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Users - admin-only access for maintenance operations
    match /users/{userId} {
      allow read: if isAuthenticated() && isAdminOrDevelopmentBypass();
      allow write: if isAdmin();
    }

    // Access logs - admin only for security monitoring
    match /access_logs/{logId} {
      allow read, write: if isAdminOrDevelopmentBypass();
    }

    // Board Documents - Access based on accessLevel field
    match /board_documents/{documentId} {
      allow read: if isAuthenticated() && (
        isAdminOrDevelopmentBypass() ||
        resource.data.accessLevel == 'public' ||
        resource.data.accessLevel == 'all'
      );
      allow write: if isAdminOrDevelopmentBypass();
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
