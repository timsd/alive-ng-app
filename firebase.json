{
  "hosting": {
    "site": "alive-ng-flutter-app",
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/privacy-policy",
        "destination": "/privacy-policy.html"
      },
      {
        "source": "/terms-conditions",
        "destination": "/terms-conditions.html"
      },
      {
        "source": "/legal",
        "destination": "/legal.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}